# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
#   cp .env.local.example .env.local
# NEXT_PUBLIC_* 는 브라우저에 노출됩니다. 그 외(service_role/비밀번호/토큰)는 서버 전용 — 절대 공개 금지.

# --- Supabase (RSVP·배달 신청 저장) ---
# https://supabase.com → 프로젝트 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# service_role 키 — 서버(어드민)에서만 사용. 절대 공개 금지.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- 공유 미리보기(OG) 절대 URL ---
# 배포 도메인. 미설정 시 상대경로 폴백. 예) https://our-wedding.example.com
NEXT_PUBLIC_SITE_URL=

# --- 카카오맵 임베드 + 카카오톡 공유 (JavaScript 키) ---
# https://developers.kakao.com → 앱 키 → JavaScript 키 (Web 플랫폼 도메인 등록 필요 · FD-6)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# --- 청첩장 접근 키 (QR/링크의 ?key=) ---
# 비어 있으면 청첩장이 전면 잠금(fail-closed) 됩니다.
NEXT_PUBLIC_INVITATION_KEY=

# --- /admin 관리자 비밀번호 ---
# ⚠︎ 반드시 강력한 값으로 설정하세요. 관리자 패널은 전체 주문·개인정보·SMS 발송을 통제합니다.
ADMIN_PASSWORD=

# --- 배경음악 BGM (FD-5, 선택) ---
# public/audio/ 에 음원을 넣고 경로 지정 시 좌상단 토글 노출. 비우면 숨김.
NEXT_PUBLIC_BGM_URL=
NEXT_PUBLIC_BGM_TITLE=

# --- 완료 화면 영상 (선택, 유튜브 비공개 링크 등) ---
# 비어 있으면 '준비 중' 표시.
NEXT_PUBLIC_VIDEO_URL=
# 마음 배송 전용 감사 영상 (선택)
NEXT_PUBLIC_HEART_VIDEO_URL=

# --- 솔라피 SMS (확정 시 문자 발송, 선택) ---
# https://solapi.com → API Key. 발신번호(SENDER)는 사전 등록 필요. 미설정 시 문자 발송 자동 skip.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# --- 카카오톡 관리자 알림 "나에게 보내기" (새 주문/마음배송 시 신랑 카톡 알림, 선택) ---
# 발급 절차는 README/기존 .env.local 주석 참고. refresh token 약 2개월 유효 — 만료 전 재발급.
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
