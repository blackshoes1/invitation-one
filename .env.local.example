# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
#   cp .env.local.example .env.local
# NEXT_PUBLIC_* 는 브라우저에 노출됩니다. 그 외(service_role/비밀번호/토큰)는 서버 전용 — 절대 공개 금지.

# --- Supabase (RSVP·배달 신청 저장) ---
# https://supabase.com → 프로젝트 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# service_role 키 — 서버(어드민)에서만 사용. 절대 공개 금지.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- 공유 미리보기(OG) 절대 URL ---
# 배포 도메인. 미설정 시 상대경로 폴백. 예) https://kkachi.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- 카카오맵 임베드 + 카카오톡 공유 (JavaScript 키) ---
# https://developers.kakao.com → 앱 키 → JavaScript 키 (Web 플랫폼 도메인 등록 필요 · FD-6)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# --- 청첩장 접근 키 (QR/링크의 ?key=) ---
# 비어 있으면 청첩장이 전면 잠금(fail-closed) 됩니다.
NEXT_PUBLIC_INVITATION_KEY=

# --- /admin 관리자 비밀번호 ---
# ⚠︎ 반드시 강력한 값으로 설정하세요. 관리자 패널은 전체 주문·개인정보·SMS 발송을 통제합니다.
# 로그인 성공 시 서버가 무작위 세션 토큰을 발급해 httpOnly 쿠키로 보관합니다(8시간, DB admin_sessions).
ADMIN_PASSWORD=

# --- 서버 서명 키 (선택, 권장) ---
# 하객 사진 업로드 토큰 등 단기 HMAC 토큰 서명에 사용. 비우면 SUPABASE_SERVICE_ROLE_KEY+ADMIN_PASSWORD
# 에서 파생합니다(둘 중 하나를 바꾸면 발급된 토큰이 모두 무효화됨). 예) openssl rand -hex 32
APP_SIGNING_SECRET=

# --- Vercel Cron 시크릿 (선택) ---
# vercel.json 의 크론(/api/notify GET)이 Authorization: Bearer <값> 으로 호출됩니다.
# Vercel 에서 CRON_SECRET 환경변수를 정의하면 자동으로 붙습니다. 비우면 크론 호출은 401 (하객 신청 시 드레인은 정상 동작).
CRON_SECRET=

# --- 배경음악 BGM (FD-5, 선택) ---
# public/audio/ 에 음원을 넣고 경로 지정 시 좌상단 토글 노출. 비우면 숨김.
NEXT_PUBLIC_BGM_URL=
NEXT_PUBLIC_BGM_TITLE=

# --- 완료 화면 영상 (선택, 유튜브 비공개 링크 등) ---
# 비어 있으면 '준비 중' 표시.
NEXT_PUBLIC_VIDEO_URL=
# 마음 배송 전용 감사 영상 (선택)
NEXT_PUBLIC_HEART_VIDEO_URL=

# --- 솔라피 SMS (확정 시 문자 발송, 선택) ---
# https://solapi.com → API Key. 발신번호(SENDER)는 사전 등록 필요. 미설정 시 문자 발송 자동 skip.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# --- 현장 체크인 공용 QR 행사 키 (?event=) — 서버 전용 ---
# 예식장에 인쇄해 두는 공용 체크인 QR 에 포함되는 키. 임의의 긴 문자열.
# 비어 있으면 공용 검색·체크인이 잠깁니다(fail-closed). 개인 QR 은 영향 없음.
# 관리자 현장운영 탭의 '공용 QR 링크' 버튼이 이 키가 포함된 인쇄용 링크를 복사해 줍니다.
CHECKIN_EVENT_KEY=
# ※ RSVP 제출 보호는 별도 키 없이 ADMIN_PASSWORD + INVITATION_KEY 에서
#   파생된 서버 전용 토큰으로 동작합니다 (src/lib/checkinServer.ts 참고).

# --- 카카오톡 관리자 알림 "나에게 보내기" (새 주문/마음배송 시 신랑 카톡 알림, 선택) ---
# refresh token 발급 절차 (자세한 내용은 src/lib/kakao.ts 헤더 주석 참고):
#   1) developers.kakao.com 앱에서 REST API 키 확인 + Redirect URI 등록 + 카카오 로그인/talk_message 동의 활성화
#   2) 브라우저에서 https://kauth.kakao.com/oauth/authorize?client_id={REST키}&redirect_uri={등록한 URI}&response_type=code&scope=talk_message
#   3) 받은 code 로 POST https://kauth.kakao.com/oauth/token (grant_type=authorization_code) → 응답의 refresh_token 사용
# ※ refresh token 약 2개월 유효 — 만료 전 재발급. 만료 여부는 /admin 패널에서 사전 감지됨(AD-4).
# ※ 알림은 DB 아웃박스(notification_outbox)에 쌓였다가 발송됩니다 — 카카오 API 가 잠시 실패해도 유실되지 않고 재시도.
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# --- 관리자 주문 알림: 텔레그램 (권장) ---
# 아래 두 개가 채워져 있으면 카카오 대신 텔레그램으로 발송합니다.
# 카카오와 달리 봇 토큰은 만료되지 않아 재발급 주기를 신경 쓸 필요가 없고,
# 메시지 길이도 4096자라 주문 내역을 온전히 담을 수 있습니다.
# 발급 절차 (자세한 내용은 src/lib/telegram.ts 헤더 주석 참고):
#   1) 텔레그램에서 @BotFather → /newbot → 봇 토큰 발급
#   2) 만든 봇과 1:1 대화방을 열고 아무 메시지나 전송 (봇은 먼저 말을 걸 수 없습니다)
#   3) https://api.telegram.org/bot{토큰}/getUpdates → result[0].message.chat.id 확인
# ※ 이 두 값을 지우면 자동으로 카카오 경로로 되돌아갑니다 (배포 롤백 불필요).
# ※ 둘 다 비어 있고 카카오도 미설정이면 알림이 발송되지 않습니다 —
#   안전망 크론(notify-drain)이 ready=false 를 장애로 잡아 알려줍니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 관리 링크 복구 문자 (문제 4) ───────────────────────────────────────────
# '내 신청 찾기'는 관리 링크를 화면에 바로 주지 않고, 신청할 때 남긴 번호로
# 문자를 보냅니다. 아래 SOLAPI_* 가 없으면 문자가 나가지 않아 **복구가 불가능**
# 합니다 (약한 인증으로 우회하지 않습니다 — 토큰을 응답에 담지 않습니다).
# 값 자체는 여기 적지 말고 Vercel 환경변수에 넣으세요.
#   SOLAPI_API_KEY / SOLAPI_API_SECRET / SOLAPI_SENDER (사전 등록된 발신번호)
